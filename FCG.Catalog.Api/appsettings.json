{
  "Serilog": {
    "MinimumLevel": "Information"
  },
  "RabbitMQ": {
    "Host": "localhost",
    "VirtualHost": "/"
  },
  "Mongo": {
    "ConnectionString": "mongodb://catalog-mongo:27017",
    "Database": "catalog_reviews"
  },
  "Redis": {
    "ConnectionString": "catalog-redis:6379"
  },
  "Elasticsearch": {
    "Url": "http://localhost:9200",
    "IndexName": "catalog-games"
  },
  "JwtSettings": {
    "Issuer": "FCG.Catalog.Api",
    "Audience": "FCG.Catalog.Client",
    "ExpirationHours": 8
  }
}
