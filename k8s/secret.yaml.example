# MODELO — não contém valores reais e NÃO é aplicado pela pipeline.
#
# Em produção (AKS) o Secret "catalog-secret" é criado pela própria pipeline
# (azure-pipelines.yml, etapa Deploy) com os valores guardados no Variable Group
# "fcg-catalog-secrets" do Azure DevOps. Nenhuma credencial fica no Git.
#
# Para rodar localmente no Docker Desktop: copie para secret.yaml (já está no
# .gitignore), preencha os valores e rode `kubectl apply -f k8s/secret.yaml`.
apiVersion: v1
kind: Secret
metadata:
  name: catalog-secret
type: Opaque
stringData:
  MSSQL_SA_PASSWORD: "<senha-do-sa>"
  ConnectionStrings__DefaultConnection: "Server=catalog-sqlserver,1433;Database=catalog;User Id=sa;Password=<senha-do-sa>;TrustServerCertificate=True"
  JwtSettings__SecretKey: "<mesma-chave-jwt-do-users-api>"
  RABBITMQ__HOST: "<host-do-rabbitmq-ou-cloudamqp>"
  RABBITMQ__VIRTUALHOST: "/"
  RABBITMQ__PORT: ""
  RABBITMQ__USESSL: "false"
  RABBITMQ__USERNAME: "<usuario>"
  RABBITMQ__PASSWORD: "<senha>"
  Elasticsearch__Url: "<https://seu-deployment.es.eastus.azure.elastic.cloud>"
  Elasticsearch__ApiKey: "<api-key-do-elastic-cloud>"
